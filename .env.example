# ============================================================================
# Tann & Thread: environment variables
# ----------------------------------------------------------------------------
# Local dev:  cp .env.example .env.local   (Next.js reads .env.local)
# Vercel:     set these in Project Settings > Environment Variables.
# Never commit real keys to git. .env.local is already git-ignored by Next.js.
# ============================================================================

# --- Phase 1: Supabase (required for the live storefront) ---
# Where to get them: Supabase dashboard > your project > Project Settings > API.
#   NEXT_PUBLIC_SUPABASE_URL:        the "Project URL" (https://xyz.supabase.co)
#   NEXT_PUBLIC_SUPABASE_ANON_KEY:   the "anon / public" key. Safe for the
#                                    browser; RLS policies limit what it can do.
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-public-key

# --- Phase 1: Supabase server-side access (recommended) ---
# Where to get it: Supabase dashboard > Project Settings > API > "service_role"
# key (keep this SECRET).
# Phase used: Phase 1, server routes only (e.g. creating COD orders, which RLS
# blocks from the browser). Must NEVER be exposed to client-side code; only
# reference it in app/api/* route handlers or server components.
SUPABASE_SERVICE_ROLE_KEY=your-service-role-secret-key

# --- Phase 2: Stripe live payments ---
# Where to get them: https://dashboard.stripe.com/apikeys
#   STRIPE_SECRET_KEY:                    "Secret key" (starts with sk_)
#   NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY:   "Publishable key" (starts with pk_)
# Phase used: Phase 2 (live card payments).
# NOTE: leaving these empty keeps card checkout in a clearly-labeled test
# scaffold mode. COD checkout works without Stripe in Phase 1.
STRIPE_SECRET_KEY=
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=

# --- Phase 2: Resend transactional emails ---
# Where to get it: https://resend.com/api-keys (create an API key, verify your
# sending domain in the Resend dashboard).
# Phase used: Phase 2 (order confirmations, shipping updates, newsletters).
RESEND_API_KEY=

# --- Phase 2a: Admin dashboard ---
# Where to set them: locally in .env.local; on Netlify in
# Site settings > Environment Variables (then redeploy).
#   ADMIN_PASSWORD: the password for /admin/login. REQUIRED before sharing
#                   the store. While unset, the demo password "admin123" works
#                   and a "change me" banner is shown.
#   ADMIN_SECRET:   any long random string, used to sign the admin session
#                   cookie. Generate one with: openssl rand -hex 32
ADMIN_PASSWORD=
ADMIN_SECRET=

# --- Phase 2b: WhatsApp order notifications (Meta Cloud API) ---
# Where to get them: see WHATSAPP_SETUP.md in the repo root.
#   WHATSAPP_PHONE_NUMBER_ID: the phone number ID from your Meta app's
#                             WhatsApp > API Setup page.
#   WHATSAPP_ACCESS_TOKEN:    a permanent system-user access token with the
#                             whatsapp_business_messaging permission. Keep
#                             this SECRET; it is only used server-side.
#   WHATSAPP_OWNER_NUMBER:    the owner's WhatsApp number, digits only
#                             (e.g. 923001234567). OPTIONAL: a default number
#                             (923017378936) is already hardcoded in
#                             lib/whatsapp.ts, and the Supabase `settings` row
#                             keyed whatsapp_owner_number overrides both.
# Without the phone number ID / access token, notifications are skipped
# silently and orders are still saved normally.
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_OWNER_NUMBER=
